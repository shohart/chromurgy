{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mfilm/contracts/render-recipe-v2.schema.json",
  "description": "SPECIFICATION CONTRACT ONLY; replace example.invalid in production",
  "title": "M-Film Creative Render Recipe v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "camera_look",
    "film",
    "optical",
    "render",
    "seed"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "preset_id": {
      "type": "string",
      "minLength": 1
    },
    "camera_look": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "strength"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "bundle_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "film": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "bundle_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "grain_scale": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "halation_scale": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "softness_scale": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "optical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preset_id",
        "strength",
        "stack"
      ],
      "properties": {
        "preset_id": {
          "type": "string",
          "minLength": 1
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "halation_policy": {
          "enum": [
            "film",
            "optical",
            "stacked",
            "disabled"
          ]
        },
        "stack": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "enabled",
              "parameters"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "enabled": {
                "type": "boolean"
              },
              "parameters": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_format",
        "output_color_space",
        "quality"
      ],
      "properties": {
        "output_format": {
          "enum": [
            "jpeg",
            "tiff",
            "png"
          ]
        },
        "output_color_space": {
          "enum": [
            "srgb",
            "display_p3",
            "rec2020"
          ]
        },
        "quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
