{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mfilm.local/schemas/creative-color-grade.schema.json",
  "title": "CreativeColorGradePreset",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "description",
    "category",
    "tags",
    "provenance",
    "parameters",
    "enabled"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "category": {
      "type": "string",
      "enum": ["warm-matte", "vintage", "social-classics", "moody", "cinematic", "editorial", "monochrome"]
    },
    "tags": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1,
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "required": ["classification"],
      "properties": {
        "classification": {
          "type": "string",
          "enum": [
            "original",
            "community-inspired",
            "editorial-inspired",
            "instagram-classics-inspired",
            "vsco-inspired",
            "internal-experimental"
          ]
        },
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "enabled": {"type": "boolean"},
    "parameters": {
      "type": "object",
      "required": ["global", "tone_curve", "split_toning", "hsl"],
      "properties": {
        "global": {
          "type": "object",
          "properties": {
            "contrast": {"type": "number"},
            "global_saturation": {"type": "number"},
            "vibrance": {"type": "number"},
            "black_lift": {"type": "number"},
            "white_rolloff": {"type": "number"}
          },
          "additionalProperties": true
        },
        "tone_curve": {"type": "object"},
        "split_toning": {"type": "object"},
        "hsl": {"type": "object"},
        "skin_protection": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
